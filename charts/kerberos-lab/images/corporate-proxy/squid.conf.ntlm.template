# Lab-only NTLM corporate parent. Uses Squid's fake NTLM helper so any
# username/password the bridge sends is accepted (proves the wire protocol).
http_port 3128
visible_hostname corporate-proxy-ntlm
pid_filename /var/run/squid/squid.pid
cache_log /var/log/squid/cache.log
access_log stdio:/var/log/squid/access.log
cache_store_log none
coredump_dir /var/spool/squid

auth_param ntlm program __NTLM_HELPER__
auth_param ntlm children 5
auth_param ntlm keep_alive on

acl authenticated proxy_auth REQUIRED
__ALLOW_ACL__
acl SSL_ports port 443
acl CONNECT method CONNECT

http_access deny !authenticated
http_access deny CONNECT !SSL_ports
http_access allow authenticated lab_dst
http_access deny all

cache deny all
