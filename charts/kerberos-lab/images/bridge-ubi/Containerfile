# Dual-mode bridge on Red Hat Squid (RHEL 9 / UBI lineage):
#   PROXY_AUTH_MODE=kerberos|negotiate → Squid login=NEGOTIATE
#   PROXY_AUTH_MODE=ntlm               → cntlm (EPEL; RH has no cntlm image/RPM in UBI)
# Lab/spike only — not a supported RHDH feature.
FROM registry.redhat.io/rhel9/squid:latest

USER root
# krb5 for Negotiate; cntlm from EPEL 9 (not in UBI AppStream / BaseOS).
RUN dnf -y install https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
 && dnf -y install krb5-workstation hostname cntlm \
 && dnf clean all \
 && command -v cntlm \
 && (command -v curl || command -v curl-minimal || true) \
 && mkdir -p /var/spool/squid /var/log/squid /var/run/squid /tmp/squid /etc/cntlm \
 && chown -R 1001:0 /var/spool/squid /var/log/squid /var/run/squid /tmp/squid /etc/cntlm \
 && chmod -R g+rwX /var/spool/squid /var/log/squid /var/run/squid /tmp/squid /etc/cntlm

COPY entrypoint.sh /entrypoint.sh
COPY healthcheck.sh /healthcheck.sh
COPY squid.conf.template /etc/squid/squid.conf.template
COPY cntlm.conf.template /etc/cntlm/cntlm.conf.template
RUN chmod 0755 /entrypoint.sh /healthcheck.sh \
 && chown 1001:0 /entrypoint.sh /healthcheck.sh /etc/squid/squid.conf.template /etc/cntlm/cntlm.conf.template

ENV REALM=LAB.LOCAL \
    KRB5_KTNAME=/keytabs/bridge-client.keytab \
    HOME=/tmp \
    PROXY_AUTH_MODE=kerberos

USER 1001
EXPOSE 3128
ENTRYPOINT ["/entrypoint.sh"]
