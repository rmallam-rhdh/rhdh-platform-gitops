# Bind loopback only. Listening on 0.0.0.0:3128 with no client auth makes the
# Hub pod IP an open forward proxy for any pod that can reach it.
http_port 127.0.0.1:3128
visible_hostname kerberos-bridge
pid_filename /tmp/squid/squid.pid
cache_log /tmp/squid/cache.log
access_log stdio:/tmp/squid/access.log
cache_store_log none
coredump_dir /var/spool/squid

# No client auth — safe only because we bind 127.0.0.1 (same-pod Hub only).
http_access allow all

# Authenticate to the lab "corporate" proxy with Negotiate (Kerberos).
cache_peer __CORP_HOST__ parent __CORP_PORT__ 0 no-query default login=NEGOTIATE
never_direct allow all

cache deny all
